<?php
declare(strict_types=1);
mb_internal_encoding('UTF-8');

/**
 * VibeDSL API - blueprint get
 * GET ?id=<blueprint-id>
 * logc=get | scope=blueprints only, exact match by id=""
 * ret html: full blueprint object for the id, 404 if absent
 */

$base = dirname(__DIR__);
require $base . '/API/lib';
$sources = vibedslSources($base);
$file = $sources['blueprints'] ?? null;

$id = trim((string)($_GET['id'] ?? ''));

header('Content-Type: text/html; charset=utf-8');

if ($file === null || !is_file($file)) {
    http_response_code(404);
    echo vibedslPage('[404] blueprint source missing', 'VibeDSL blueprint get');
    exit;
}

if ($id === '') {
    echo vibedslPage('rsn: id required GET ?id=<blueprint-id>', 'VibeDSL blueprint get');
    exit;
}

$text = (string)file_get_contents($file);
$objects = preg_split('/(?m)(?=^[ \t]*\*->)/', $text);

foreach ($objects as $obj) {
    if (preg_match('/id="([^"]*)"/', $obj, $m) && $m[1] === $id) {
        echo vibedslToHtml(rtrim($obj), 'VibeDSL blueprint get: ' . $id);
        exit;
    }
}

http_response_code(404);
echo vibedslPage(sprintf('[404] no blueprint with id="%s"', $id), 'VibeDSL blueprint get');