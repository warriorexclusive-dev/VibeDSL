// VIBE_IDE - karas okna, lib dearpygui 2.3.1
// logika - slova spravochnika, imena sobstvennye v "", opisaniya russkij
// creative = 0

ʩ ◒⩲"root" ≕⩲"vibide" §⩲"vibide" ∁⩲"root"→⁐ ≣ ◈ [spec] lng⩲"VibeDSL"

// ---- abstract prop
• ⌰:⬝:§⩲"chrome"→▱:◒⩲"chrome"
• ⌰:⬝:§⩲"bar"→▱:◒⩲"bar"
• ⌰:⬝:§⩲"menu"→▱:◒⩲"menu"
• ⌰:⬝:§⩲"frm"→▱:◒⩲"frm"

• ⌰:⌗:§⩲"corner"→▱:⌗
• ⌰:⌗:§⩲"radius"→▱:corner:⌗
• ⌰:⌗:§⩲"font"→▱:⌗
• ⌰:⌗:§⩲"font_size"→font:⌗
• ⌰:⌗:§⩲"par"{"nest"}→▱:"par"
• ⌰:⬝:§⩲"tab_view"→▱:◒⩲"tab_view"
• ⌰:⌗:§⩲"func"→▱:"func"
• ⌰:⌗:§⩲"mapping"{"group"}→▱:"mapping"

// ---- abstract func: okno

• ⌰:ʩ:§⩲"open_view"→⁐⩲"create(view) + view:name:set(...) + view:fullscreen:set(true) + action=show(view)":
      ◈(❒)→❒:≕:⇐("VibeDSL IDE")→❒:⛶:⇐(⊤)→⁐⩲▸(❒)

// ---- abstract func: tema

• ⌰:ʩ:§⩲"read_colors"→℗⩲▯→⁐⩲"load(file) + split(mapping:group) + mapping:num:set(13) + save(cfg:mapping ...)"→⏎(▯)→✂(mapping:group)→mapping:℉:⇐(13)→⬊(☰:mapping "PY_IDE/style.json")

• ⌰:ʩ:§⩲"set_theme"→⁐⩲"load(mapping:theme) + frm:corner:radius:set(15) + frm:font:set(...) + font:font_size:set(...) + action=show(theme)"→⏎(mapping:▚)→▱:corner:radius:⇐(15)→▱:font:⇐("Arial")→font:font_size:⇐([12,14])→⁐⩲▸(▚)

• ⌰:ʩ:§⩲"bind_theme"→⁐⩲"nasledovanie temy: view:theme:set()..console:theme:set() + action=show(theme)":
      ❒:▚:⇐()→▱:▚:⇐()→↓:▚:⇐()→⬋:▚:⇐()→⬅:▚:⇐()→➡:▚:⇐()→tab_view:▚:⇐()→◄:▚:⇐()→▖:▚:⇐()→▌:▚:⇐()→⁐⩲▸(▚)

• ⌰:ʩ:§⩲"reload_theme"→℗⩲☰→⁐⩲"load(cfg:mapping) + run(set_theme) + run(bind_theme)"→⏎(☰:mapping)→▶(set_theme)→▶(bind_theme)→⤴("theme perezchitan, vizual obnovlen")→⤴("cfg otsutstvuet, staryj theme ostal")

// ---- abstract func: bar

• ⌰:ʩ:§⩲"build_nav"→⁐⩲"create(nav) + nav:par:set(...) + add(nav:par ...) x4 + action=show(nav)":
      ◈(◄)→◄:par:⇐("file")→⁝(◄:par "view")→⁝(◄:par "option")→⁝(◄:par "help")→◄:⊡:⇐(∄)→⁐⩲▸(◄)

• ⌰:ʩ:§⩲"add_par"→℗⩲par_nav→⁐⩲"add(nav:par par) + add(par:nest par)"→⁝(◄:par par)→⁝(par:nest par)→⤴("par dobavlen")→⤴("par pust, nichego ne dobavlen")

• ⌰:ʩ:§⩲"set_text"→℗⩲par_text→⁐⩲"item:name:set(par)"→⬝:≕:⇐(par)→⤴("name zamenen")

• ⌰:ʩ:§⩲"del_item"→⁐⩲"remove(item)":
      ␡(⬝)→⤴("item i nest udaleny")

// ---- abstract func: okno

• ⌰:ʩ:§⩲"build_chrome"→⁐⩲"create(chrome) + create(bar) + add(bar:btn minimayz) + add(bar:btn maksimayz) + create(menu) + add(menu:item) x4 + action=show(bar) + action=show(menu)"
      ◈(chrome)→◈(bar)→⁝(bar:▢ ≕⩲"minimayz")→⁝(bar:▢ ≕⩲"maksimayz")→◈(menu)→⁝(menu:⬝ ≕⩲"file")→⁝(menu:⬝ ≕⩲"edit")→⁝(menu:⬝ ≕⩲"run")→⁝(menu:⬝ ≕⩲"help")→⁐⩲▸(bar)→⁐⩲▸(menu)      ◈(bar)→⁝(bar:▢ ≕⩲"minimayz")→⁝(bar:▢ ≕⩲"maksimayz")→◈(menu)→⁝(menu:⬝ ≕⩲"file")→⁝(menu:⬝ ≕⩲"edit")→⁝(menu:⬝ ≕⩲"run")→⁝(menu:⬝ ≕⩲"help")→⁐⩲▸(bar)→⁐⩲▸(menu)

• ⌰:ʩ:§⩲"click_minimayz"→⁐⩲"view:fullscreen:set(false) + return("okno svernuto")":
      ❒:⛶:⇐(⊥)

• ⌰:ʩ:§⩲"click_maksimayz"→⁐⩲"view:fullscreen:set(true) + return("okno razvorotano")":
      ❒:⛶:⇐(⊤)

• ⌰:ʩ:§⩲"build_menu"→⁐⩲"run(controller_menu) + nav:par:set(...) + action=show(menu)":
      ▶(controller_menu)→◄:par:⇐(...)→⁐⩲▸(menu)

// ---- abstract func: kontrollery
//   incld - atribut prinadlezhnosti, NE import. Element obyavlyaet, kakoy
//   kontroller emu prinadlezhit; smena znacheniya menyayet povedenie, poetomu
//   kontrollery vzaimozamenyaemy. Kazhdyy controller_* - abstract, to est ego mozhno
//   pomenyat na lyuboy drugoy takoy zhe formy.

• ⌰:⬝:§⩲"controller_bar"→⁐⩲"bar:incld:set(\"controller_bar⧵") + add(bar:btn name=\"minimayz⧵") + add(bar:btn name=\"maksimayz⧵") + action=show(bar)":
      bar:⊂:⇐("controller_bar")→⁝(bar:▢ ≕⩲"minimayz")→⁝(bar:▢ ≕⩲"maksimayz")→⁐⩲▸(bar)

• ⌰:⬝:§⩲"controller_menu"→⁐⩲"menu:incld:set(\"controller_menu⧵") + add(menu:item) x4 + action=show(menu)":
      menu:⊂:⇐("controller_menu")→⁝(menu:⬝ ≕⩲"file")→⁝(menu:⬝ ≕⩲"edit")→⁝(menu:⬝ ≕⩲"run")→⁝(menu:⬝ ≕⩲"help")→⁐⩲▸(menu)

• ⌰:⬝:§⩲"controller_frm"→⁐⩲"frm:incld:set(\"controller_frm⧵") + frm:module:set(true) + frm:split:set(factor [65,35]) + action=show(frm)":
      ▱:⊂:⇐("controller_frm")→▱:■:⇐(⊤)→▱:✂:⇐(× [65,35])→⁐⩲▸(▱)

• ⌰:⬝:§⩲"controller_left"→⁐⩲"left:incld:set(\"controller_left⧵") + left:min:set(50) + left:max:set(factor 25) + action=show(left)":
      ⬅:⊂:⇐("controller_left")→⬅:⌊:⇐(50)→⬅:⌋:⇐(× 25)→⁐⩲▸(⬅)

• ⌰:⬝:§⩲"controller_right"→⁐⩲"right:incld:set(\"controller_right⧵") + right:min:set(50) + right:max:set(factor 25) + action=show(right)":
      ➡:⊂:⇐("controller_right")→➡:⌊:⇐(50)→➡:⌋:⇐(× 25)→⁐⩲▸(➡)

• ⌰:⬝:§⩲"controller_tab"→⁐⩲"tab_view:incld:set(\"controller_tab⧵") + add(tab_view:inp type=\"¶⧵") + action=show(tab_view)":
      tab_view:⊂:⇐("controller_tab")→⁝(tab_view:▖ ◒⩲"text")→⁐⩲▸(tab_view)

• ⌰:⬝:§⩲"controller_editor"→⁐⩲"inp:incld:set(\"controller_editor⧵") + load(inp:text) + action=show(inp)":
      ▖:⊂:⇐("controller_editor")→⏎(▖:¶)→⁐⩲▸(▖)

• ⌰:⬝:§⩲"controller_console"→⁐⩲"console:incld:set(\"controller_console⧵") + console:factor:set(50) + action=show(console)":
      ▌:⊂:⇐("controller_console")→▌:×:⇐(50)→⁐⩲▸(▌)

• ⌰:⬝:§⩲"controller_nav"→⁐⩲"nav:incld:set(\"controller_nav⧵") + nav:par:set(...) + add(nav:par ...) x4 + action=show(nav)":
      ◄:⊂:⇐("controller_nav")→◄:par:⇐(...)→⁝(◄:par ...) x4→⁐⩲▸(◄)

• ⌰:⬝:§⩲"swap_ctl"→℗⩲element→℗⩲ctl→⁐⩲"element:incld:set(ctl) + return(\"kontroller pomenyan⧵")":
      element:⊂:⇐(ctl)

// ---- abstract func: karcas

• ⌰:ʩ:§⩲"build_frm"→⁐⩲"add(chrome frm) + frm:incld:set(\"controller_frm⧵") + frm:module:set(true) + frm:split:set(factor [65,35]) + action=show(frm)"
      ⁝(chrome ▱)→▱:⊂:⇐("controller_frm")→▱:■:⇐(⊤)→▱:✂:⇐(× [65,35])→⁐⩲▸(▱)      ◈(▱)→▱:■:⇐(⊤)→▱:✂:⇐(× [65,35])→⁐⩲▸(▱)

// ---- abstract func: verh

• ⌰:ʩ:§⩲"build_top"→⁐⩲"create(column) + create(left) + run(controller_left) + create(row) + create(tab_view) + run(controller_tab) + create(inp) + run(controller_editor) + create(right) + run(controller_right)"
      ◈(↓)→◈(⬅)→▶(controller_left)→◈(⬋)→◈(tab_view)→▶(controller_tab)→◈(▖)→▶(controller_editor)→◈(➡)→▶(controller_right)      ◈(↓)→◈(⬅)→⬅:⌊:⇐(50)→⬅:⌋:⇐(× 25)→◈(⬋)→◈(tab_view)→⁝(tab_view:▖ ◒⩲"text")→◈(➡)→➡:⌊:⇐(50)→➡:⌋:⇐(× 25)→⁐⩲▸(⬅)→⁐⩲▸(tab_view)→⁐⩲▸(➡)

• ⌰:ʩ:§⩲"set_left"→℗⩲size_left→⁐⩲"left:size_left:set(par), granitsy: min 50, max factor 25"→⬅:″:⇐(par)→⤴("size zamenen mezhdu min 50 i max factor 25")→⤴("vne granits, left sohranil size")

• ⌰:ʩ:§⩲"set_right"→℗⩲size_right→⁐⩲"right:size_right:set(par), granitsy: min 50, max factor 25"→➡:″:⇐(par)→⤴("size zamenen mezhdu min 50 i max factor 25")→⤴("vne granits, right sohranil size")

• ⌰:ʩ:§⩲"open_left"→⁐⩲"action=show(left)":
      ⁐⩲▸(⬅)

• ⌰:ʩ:§⩲"close_left"→⁐⩲"close(left)":
      Œ(⬅)

• ⌰:ʩ:§⩲"open_right"→⁐⩲"action=show(right)":
      ⁐⩲▸(➡)

• ⌰:ʩ:§⩲"close_right"→⁐⩲"close(right)":
      Œ(➡)

• ⌰:ʩ:§⩲"add_tab"→℗⩲par_tab→⁐⩲"add(tab_view) + run(set_tab_name) + tab_view:text:set(par) + action=show(tab_view)"→⁝(tab_view)→▶(set_tab_name)→tab_view:¶:⇐(par)→⁐⩲▸(tab_view)

• ⌰:ʩ:§⩲"set_tabs"→℗⩲℉→⁐⩲"tab_view:num:set(par)"→tab_view:℉:⇐(par)→⤴("num tab zamenen funkciej")→⤴("num vne granits, num bezmenen")

• ⌰:ʩ:§⩲"set_tab_name"→℗⩲name_tab→⁐⩲"tab_view:name:set(name_tab)"→tab_view:≕:⇐(par)→⤴("name tab zamenen")→⤴("tab net, name ne zamenen")

• ⌰:ʩ:§⩲"close_tab"→⁐⩲"close(tab_view)":
      Œ(tab_view)

// ---- abstract func: niz

• ⌰:ʩ:§⩲"build_bottom"→⁐⩲"add(column row) + create(console) + run(controller_console) + create(console2) + run(controller_console) + action=show(console)"
      ⁝(↓ ⬋)→◈(▌)→▶(controller_console)→◈(console2)→▶(controller_console)→⁐⩲▸(▌)   ⁝(↓ ⬋)→⁝(⬋:▌) x2→▌:×:⇐(50)→⁐⩲▸(▌)

• ⌰:ʩ:§⩲"set_console"→℗⩲×→⁐⩲"console:size:set(factor), factor 25"→▌:″:⇐(×)

• ⌰:ʩ:§⩲"del_console"→⁐⩲"remove(console) + console:factor:set(100)":
      ␡(▌)→▌:×:⇐(100)→⤴("odin console udalen, vtoroy zanyal vsyu shirinu")

• ⌰:ʩ:§⩲"add_console"→⁐⩲"add(console) + console:factor:set(50)":
      ⁝(▌)→▌:×:⇐(50)→⤴("console vozvrashchena, dva po 50")

// ---- abstract func: vhodnaya

• ⌰:ʩ:§⩲"fill_bar"→℗⩲⊡→⁐⩲"nav:content:set(par) + action=show(nav)"→◄:⊡:⇐(par)→⁐⩲▸(◄)→⤴("slot nav napolnen vhodnoy funkciej")

• ⌰:ʩ:§⩲"fill_panel"→⁐⩲"create(frm v sht)":
      ◈(▱ « ▄)→⤴("sht napolnena podoknom")

• ⌰:ʩ:§⩲"fill_editor"→℗⩲¶→⁐⩲"load(inp:text par)"→⏎(▖:¶ par)→⤴("content editor - text otkrytogo fayla")→⤴("fayla net, editor pust")

• ⌰:ʩ:§⩲"fill_bound"→⁐⩲"vhodnaya func napolnyaet tolko svoye okno":
      ⤴("vhodnaya func napolnyaet tolko svoye okno")

// ---- abstract func: vneshnyaya komanda

• ⌰:ʩ:§⩲"cmd"→℗⩲name_cmd→⁐⩲"run(io:func par)"→▶(⬄:func par)→⤴("func zapushchena")→⤴("par net, nichego ne izmeneno")

// ---- abstract func: sborka

• ⌰:ʩ:§⩲"build_all"→⁐⩲"run(open_view) -> run(read_colors) -> run(set_theme) -> run(bind_theme) -> run(build_nav) -> run(build_chrome)->run(build_menu)->run(build_frm) -> run(build_top) -> run(build_bottom)":
      ▶(open_view)→▶(read_colors)→▶(set_theme)→▶(bind_theme)→▶(build_chrome)→▶(build_menu)→▶(build_nav)→▶(build_frm)→▶(build_top)→▶(build_bottom)

• ⌰:ʩ:§⩲"no_literal"→⁐⩲"v kode net theme, cvet, razmera":
      ⤴("karcas pust, vse cherez func")→⤴("func mozhno vyzvat snova, sostoyanie iz dannyh")→⤴("lyubaya func dostizhima iz cmd po imeni")

// ---- part: sobiranie

╂ 0: "run"
   →▱:≕⩲"run":
      →⬝:≕⩲"on_open":⟡⩲"on_open"→⁐⩲▶(build_all)⊎:
         →⁐⩲⤴("vse func po poryadku")
      →⬝:≕⩲"on_cmd":⟡⩲"on_cmd"→⁐⩲▶(cmd)⊎:
         →⁐⩲⤴("vneshnyaya komanda")
      →⬝:≕⩲"on_theme":⟡⩲"on_theme"→⁐⩲▶(set_theme)⊎:
         →⁐⩲⤴("theme zadan")
      →⬝:≕⩲"on_reload":⟡⩲"on_reload"→⁐⩲▶(reload_theme)⊎:
         →⁐⩲⤴("theme perezchitan")
      →⬝:≕⩲"on_goal":⟡⩲"on_goal"→⁐⩲▶(no_literal)⊎:
         →⁐⩲⤴("vse checks")
      →⁐⩲▸(▶)

// ---- part: paneli

╂ 1: "panels"
   →▱:≕⩲"panels":
      →⬝:≕⩲"on_open":⟡⩲"on_open"→⁐⩲▸(⬅)⊎:
         →⁐⩲▸(⬅)
         →⁐⩲▸(➡)
      →⬝:≕⩲"on_open_left":⟡⩲"on_open_left"→⁐⩲▶(open_left)⊎:
         →⁐⩲⤴("left otkryta")
      →⬝:≕⩲"on_close_left":⟡⩲"on_close_left"→⁐⩲▶(close_left)⊎:
         →⁐⩲⤴("left zakryta")
      →⬝:≕⩲"on_open_right":⟡⩲"on_open_right"→⁐⩲▶(open_right)⊎:
         →⁐⩲⤴("right otkryta")
      →⬝:≕⩲"on_close_right":⟡⩲"on_close_right"→⁐⩲▶(close_right)⊎:
         →⁐⩲⤴("right zakryta")
      →⬝:≕⩲"on_left_size":⟡⩲"on_left_size"→⁐⩲▶(set_left)⊎:
         →⁐⩲⤴("size left")
      →⬝:≕⩲"on_right_size":⟡⩲"on_right_size"→⁐⩲▶(set_right)⊎:
         →⁐⩲⤴("size right")
      →⁐⩲▸(panels)

