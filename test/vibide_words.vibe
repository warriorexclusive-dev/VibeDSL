anchor dracula_theme = [
    background = #282a36,
    foreground = #f8f8f2,
    current_line = #44475a,
    comment = #6272a4,
    keyword = #8be9fd,
    function = #50fa7b,
    number = #ff5555,
    constant = #bd93f9,
    error = #ff5555
]

create:project:"VIBE_IDE":lang:"python":
    child create:file:filetype=.vibedsl:type=project:content:id="project":
        child project:files
        child project:description
        child project:languages
        child project:rules
        child project:links
    child create:library:"dearpygui 2.3.1":
        child window:fullscreen:theme:child:link dracula_theme multivec
            child menu:languages:[RU,EN]
                child select:language:location=right
                child file:
                    child new
                    child open
                    child open:project:link project
                    child save:project:link project
                    child print:file
                child view:
                    child font:size
                    child styles
                    child views:on|off
                        child left:panel
                        child right:panel
            child left:panel:weight="stretch":size=[min=5%,max=25%,default=15%]:pinned:window
                child project:files
            child right:panel:weight="stretch":size=[min=5%,max=25%,default=15%]:pinned:window
                child help:content=this:child rules:50%
                child symbols:content=
            child tab:bar:location=top:files:
                child code:editor:weight="fill":
            child bottom:panel:size:window:y=40%:child:weight="stretch":
                child spellchecker:size:link bottom:x=50%:
                    child spellchecker:behavior:
                        child rules=link RULES
                        child event=onUpdateText
                        child methods:
                            child scan:link:id:anchors:store:memory
                            child check:links:id:anchors:
                child console:cmd:size:link bottom:x=50%