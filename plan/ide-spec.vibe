fun type="root" name="vibedsl-ide" id="vibedsl-ide" scop="root" -> act == crt [spec] lng="VibeDSL"
   -> show "spec of the whole VibeDSL IDE: page frame, editor boot, draft lifecycle, live validation, open/save/demo, reference panel with dictionary self-check, dictionary add modal, validator core (python/js parity), data pipeline, api contract"
   -> show "rule: no free-form custom blocks; detail lives in quoted strings, structure in declared tokens"

part 0: "page frame"
   -> show "index.html - single dark page, three zones, one modal"
   -> run "header: title text VibeDSL IDE, status badge, spacer, saved label, file name input, open save demo help buttons, hidden file input accept .vibe .txt"
   -> run "work zone: editor host div plus reference aside"
   -> run "bottom zone: problems list plus log pre"
   -> run "modal: section select, value input, description input, example input, preview pre, result div, cancel and ok buttons"
   -> show "css tokens: background #1e1e1e, text #d4d4d4, panel #252526, border #3c3c3c, accent #3794ff, pass #6a9955 on #1e3d1e, fail #f48771 on #3d1e1e, log color #9cdcfe, title color #4ec9b0"
   -> show "aside is closed by default, flex basis 0, opens to 25 percent with transition; bottom zone fixed at 32 percent height"
   -> show "scripts: monaco loader, data.js, validator.js, main.js"
   -> ret "ok"

part 1: "editor boot"
   -> show "main.js wraps init in try so any error writes status badge fail with the message and the log with the stack"
   -> run "require config: monaco vs path resolves to temp/package/min/vs locally or to the host path over http"
   -> run "monaco language registration: id vibedsl, extensions .vibe and .txt"
   -> run "language configuration: line comment //, block comment pair, bracket pairs, auto closing pairs for parens brackets braces and double quote"
   -> run "monarch tokenizer: token postfix vibedsl, comment classes, star arrow key, vector and operator class, delimiter class, string class, invalid string class, number class, identifier with keyword table"
   -> run "keyword table: fun func function abstract alias as use type act name par desc id ret halt"
   -> run "operator pattern: multi vector, colon branch pair, two way link, ampersand arrow, double colon, points, plain arrow, prev arrow, alone branch, comparators, ternary, assignment colon, boolean and or"
   -> run "editor options: theme vs dark, automatic layout, minimap off, font size 14, selection whitespace, no scroll beyond last line"
   -> run "model created from data.js demo source, language vibedsl"
   -> ret "ok"

part 2: "draft lifecycle"
   -> show "two local slots: current file name under key active, per-name text under key draft prefix plus name"
   -> run "name resolution: empty input becomes edit.vibe, a name without a dot gets dot vibe appended"
   -> run "local setter and getter wrapped in try to survive private browsing mode"
   -> run "restore on boot: read active name, read its draft, apply only when the draft differs from the bundled demo, log a line restored autosaved draft, badge draft restored"
   -> run "server autosave posts json name and text to api save, only under the http protocol"
   -> show "server ok: badge saved with local time hours minutes seconds plus the stored file path"
   -> show "server fail: badge save error with the server message, or no autosave server router down when the fetch itself rejects"
   -> run "quiet mode suppresses the failure badge, used by background saves"
   -> run "timers: any content change schedules validation after 250 ms and local draft save after 400 ms"
   -> run "autosave interval 10 s, plus a save on page unload and on tab visibility hidden"
   -> show "badge editing during typing"
   -> ret "ok"

part 3: "open save demo"
   -> show "open button clicks the hidden file input; change reads the file as text, sets the name input to the file name, replaces the model text"
   -> show "after open: local draft saved, server autosave fired, editor focused, input value reset to allow the same file again"
   -> show "boot tail: restore the draft, run a validation, focus the editor"
   -> show "save button: current name resolved, blob download with that name, local draft saved, server autosave with feedback"
   -> show "demo button restores the bundled demo source from data.js"
   -> ret "ok"

part 4: "live validation"
   -> run "validate now: call validator validate on the model text with dict text, dict name, protos, blueprints, syntax and editor source name"
   -> run "markers applied to the monaco model under language id vibedsl"
   -> run "status badge shows verdict plus error and warning counts, class pass or fail"
   -> run "log pre receives the validator out lines joined by newline"
   -> run "problems list: every marker of error severity becomes a row with line and column and message"
   -> run "row click moves the editor cursor to that line and column, reveals the line, focuses the editor"
   -> show "empty problem list renders a no errors row in pass color"
   -> ret "ok"

part 5: "reference panel"
   -> show "reference map: action, mapping, operators, abstracts and syntax sections read from data.js payload"
   -> run "check keys are exactly those five sections"
   -> show "cache: one validate result per section, computed once on demand with a dictionary source name prefix"
   -> show "button badge: each checkable button gains a span with checkmark pass or error count fail"
   -> show "open section: the help pre shows the dictionary check head, either fail with per-line messages or pass, then the plain section source"
   -> show "active section button gets the active class"
   -> show "help button toggles the aside open state, lazily opens the active section on first open, then relayouts the editor"
   -> ret "ok"

part 6: "dictionary add modal"
   -> show "known aliases built once from entry aliases of the dict text into a set with exact and lowercase forms"
   -> run "preview composes an entry line star arrow value dash description and an example line when present; empty fields show a hint"
   -> show "open: section sanitized so syntax falls back to action, fields cleared, result cleared, modal shown, value focused"
   -> run "submit: value and description are required, otherwise the result shows value and description are required"
   -> run "submit: each comma separated alias trimmed and lowercased, any hit in the known set rejects with alias already in dictionary"
   -> run "submit: posts json section value description example to api dict add"
   -> show "ok: active section stored under key add ref, result shows added and reloading, page reload after 400 ms"
   -> show "error: result shows the server error, or server unreachable router down on fetch rejection"
   -> show "cancel hides the modal; typing in any field recomposes the preview"
   -> ret "ok"

part 7: "validator core"
   -> show "entry aliases: star arrow lines, head split on dash separator, aliases comma separated, each added exact and lowercase"
   -> run "known set: dictionary aliases plus syntax aliases plus the built in stage scop srch mix"
   -> show "state reset: the typed registers and the reach set are cleared at the start of every validate run so files never leak into each other"
   -> show "masking: custom blocks, line comments and block comments blanked out, quoted string contents preserved"
   -> show "tree: tabs to spaces, blank and hash lines skipped, indent stack builds parent child relations, deeper indent child, equal indent sibling"
   -> show "declared symbols: abstract ids from id attribute or quoted name, as binds, fun declarations, entity act declarations with a name"
   -> show "abstract register: full syntax parse, type list function prop item, quoted init compounds become object pin pairs in typed sets"
   -> show "use targets: agent ignored, source form ignored, prototype list form, id form, else bare words minus the skip list"
   -> show "blueprint symbols: declaration scan, abstract register, recursive use walk over loaded entries with a seen guard"
   -> run "compute blocks: every node symbol unioned upward so a symbol is visible in its whole subtree chain"
   -> show "resolve uses: reachable entry ids join the reach set and their symbols join the node, missing targets recorded"
   -> show "duplicate ids: abstract ids must not repeat reachable base ids or earlier ids in the same spec"
   -> run "rule 1: after a branching operator a line must have indented children and every variant child must start with an arrow"
   -> run "rule 2: a change operator must carry an act or action assignment inside"
   -> run "rule 3: command words scanned at line start or after an operator; words under length 2, known words, the stage word and visible symbols pass"
   -> show "rule 3 detail: quote contents are masked before the scan, a word glued to an alphanumeric or a closing bracket before it is skipped"
   -> show "rule 3 detail: on a branch child line the leading arrow word is stripped before the word scan so the variant verb itself is not attacked"
   -> show "rule 4: object pins, a compound on a declared object must be an owned pin or visible, otherwise unknown pin error"
   -> show "rule 5: parenthesis balance over the whole block, extra closing forces the scope back, an unclosed scope at the end is an error"
   -> show "rule 6: missing use targets reported as not in base"
   -> run "geometry: the message quote text is located in the raw line to compute marker column"
   -> run "output: sorted by line then kind then message, deduplicated by message, verdict pass when no errors"
   -> run "result shape: out lines, markers with severity 8, error count, warning count zero, verdict"
   -> ret "ok"

part 8: "parity and tests"
   -> show "the js validator output is byte identical to the python cli output, modulo line ending"
   -> run "parity driver: same source feeds python and js, both normalized, first divergence reported"
   -> run "file cases: syntax, protos, blueprints, master dictionary, the demo spec"
   -> run "line cases: undeclared call, missing use target, event lines with and without scopes, load call, search example, multi vector sample, abstract and entity act declarations, unknown pin, deep inline use, custom and comment masking"
   -> run "exit code one on any failure, success prints all cases pass"
   -> ret "ok"

part 9: "data pipeline"
   -> run "generator: reads master dictionary, action mapping operators abstracts split files, protos, blueprints, syntax and a demo source"
   -> show "demo source path: temp opencode demo spec; fallback inline example when absent"
   -> run "generator writes data.js with a do not edit header and a payload dict, dict name, section texts, protos, blueprints, syntax, demo"
   -> show "payload exposed both as a module export and as a window global"
   -> run "sorter: sections found by type headers, entries split at line beginnings, sorted by primary alias case insensitive inside each section"
   -> show "sorter write mode rewrites the master keeping section header order, report mode lists every inversion with a fix hint"
   -> run "spell checker: sections mapped to files, action mapping logical operators abstracts and behavior merged into action.dict mapping.dict operators.dict abstracts.txt"
   -> run "spell checker prepends a start language dictionary prefix to each split file and counts entries"
   -> show "spell checker aborts with a message listing every expected section that is missing from the master"
   -> show "stage 2 channel a: fetch the whole dictionary through the rag api, delete stale part files and canon files, then rebuild from the fetched text"
   -> run "stage 2 channel b: search the rag api for four terms, mix the results into one blob, then rebuild from that blob"
   -> show "pipeline add: validates section, value, description and the value restrictions, rejects duplicate aliases, inserts a composed block before the next section header"
   -> run "pipeline add rebuilds through sorter write, spell checker and generator, answers a single json line"
   -> ret "ok"

part 10: "api contract"
   -> show "router: root path serves the index file, any other path maps through real path, self request gets a 404, a candidate must stay inside the root and carry no dot in its base name"
   -> show "shared lib: page wrapper, text to html normalizer, source name to data file map for dictionary action mapping operators abstracts syntax blueprints protos agents"
   -> show "landing page index: ascii logo rendered from a glyph map, base syntax block, vectors block, ui layer block, prototypes and scope block, api endpoints table, license footer"
   -> run "get: optional dict parameter, default dictionary, unknown or missing file returns a 404 page listing valid names"
   -> run "search: sources are the dictionary, syntax and agents; blueprints and protos are excluded"
   -> run "search: term required, otherwise a reason page, objects split on star arrow markers, leading blank lines stripped, right trimmed, line endings normalized, case sensitive substring, no match page on empty"
   -> run "save: post or put with json or form, cors headers and an options preflight answer"
   -> run "save: name sanitized to safe chars with an automatic dot vibe suffix, written under the temp store, answered with ok file and bytes, write failure answered as a 500"
   -> show "dict add: post json only, cors headers and an options preflight answer, bad json body rejected with a message"
   -> show "dict add: section in the allowed set, value and description required, value must not carry a dash separator or star arrow prefix, length caps for value description example"
   -> show "dict add: normalized to one line, piped to a temp input file, python located on path, pipeline run, last output line parsed as json and echoed back with a server tag"
   -> show "prototype and blueprint endpoints mirror over their own scopes: exact id get with 404, substring search on id or description case insensitive"
   -> ret "ok"

part 11: "quality gates"
   -> run "validation of the spec itself: every command word declared or visible, no unmatched scopes, no branch misuse"
   -> run "parity between the js validator and the python validator over the file and line cases"
   -> run "dictionary self checks over action mapping operators abstracts syntax sections all clean"
   -> ret "ok"

part 12: "hand off"
   -> show "implement the described logic in two working pairs of sources and keep the divergence under five percent excluding comments"
   -> show "verify both variants run and pass the quality gates before the hand off answer"
   -> ret "ok"