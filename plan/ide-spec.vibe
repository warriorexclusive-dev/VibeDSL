fun type="root" name="vibedsl-ide" id="vibedsl-ide" scop="root" -> act == crt [spec] lng="VibeDSL"

&-> abstract prop id="theme" -> frm:"theme"
&-> abstract prop id="marks" -> frm:"marks"
&-> abstract prop id="sizes" -> frm:"sizes"
&-> abstract prop id="header" -> frm:"header"
&-> abstract prop id="work" -> frm:"work"
&-> abstract prop id="bottom" -> frm:"bottom"
&-> abstract prop id="modal" -> frm:"modal"
&-> abstract prop id="register" -> frm:"register"
&-> abstract prop id="config" -> frm:"config"
&-> abstract prop id="keys" -> frm:"keys"
&-> abstract prop id="op" -> frm:"op"
&-> abstract prop id="opt" -> frm:"opt"
&-> abstract prop id="draft" -> frm:"draft"
&-> abstract prop id="state" -> draft:"state"
&-> abstract prop id="live" -> frm:"live"
&-> abstract prop id="result" -> live:"result"
&-> abstract prop id="ref" -> frm:"ref"
&-> abstract prop id="src" -> ref:"src"
&-> abstract prop id="add" -> frm:"add"
&-> abstract prop id="entry" -> add:"entry"
&-> abstract prop id="preview" -> add:"preview"
&-> abstract prop id="finder" -> frm:"finder"
&-> abstract prop id="known" -> finder:"known"
&-> abstract prop id="decls" -> finder:"decls"
&-> abstract prop id="use_map" -> finder:"use_map"
&-> abstract prop id="scan" -> finder:"scan"
&-> abstract prop id="out" -> finder:"out"
&-> abstract prop id="parity" -> frm:"parity"
&-> abstract prop id="goal" -> parity:"goal"
&-> abstract prop id="feed" -> parity:"feed"
&-> abstract prop id="files" -> parity:"files"
&-> abstract prop id="pipe" -> frm:"pipe"
&-> abstract prop id="data" -> pipe:"data"
&-> abstract prop id="api" -> frm:"api"
&-> abstract prop id="page" -> api:"page"

part 0: "frame"
   -> frm:name="ide_page":
      -> exm: frm header="title, status, name, saved, open, save, demo, help, file"
      -> exm: frm work="editor, panel"
      -> exm: frm bottom="problems, log"
      -> exm: frm modal="add_entry"
      -> exm: frm theme="bg #1e1e1e, text #d4d4d4, surface #252526, border #3c3c3c"
      -> exm: frm marks="pass #6a9955, fail #f48771, log #9cdcfe, title #4ec9b0, focus #3794ff"
      -> exm: frm sizes="aside 25 percent, bottom 32 percent, speed 150ms"
      -> show(frame)

part 1: "boot"
   -> frm:name="monaco":
      -> item:name="boot" event="on_load"->act=load(module name="monaco")<>:
         -> act=show("<model>")
         -> out:"boot error"
      -> exm: frm register="lang vibedsl, extn .vibe .txt"
      -> exm: frm config="comment, block, brackets, auto close brackets and quotes"
      -> exm: frm keys="fun, act, name, par, desc, id, ret, use, abstract, alias, show, save"
      -> exm: frm op="vectors, branch, link, colon, equals, or, and, negate, diag"
      -> exm: frm opt="theme vs-dark, layout auto, minimap off, font 14, beyond no"
      -> show(monaco)

part 2: "slot"
   -> frm:name="draft":
      -> item:name="resolve" event="on_open"->act=select(name)<>:
         -> act=ret(name "edit.vibe")
         -> act=ret(name "no dot" "append .vibe")
         -> act=ret(name "empty" "edit.vibe")
      -> item:name="store" event="on_edit"->act=save(draft)<>:
         -> act=ret("saved HH:MM:SS + path")
         -> out:"private mode"
      -> item:name="server" event="on_hide"->act=set(api "API/save")<>:
         -> act=save(draft)
         -> out:"router down"
      -> show(draft)

part 3: "io"
   -> frm:name="io":
      -> item:name="open" event="on_io"->act=select(file)<>:
         -> act=set(name)
         -> act=show(model)
      -> item:name="after" event="on_save"->act=save(slot)<>:
         -> act=set(api "push server")
         -> act=set(ui "focus, reset input")
      -> item:name="download" event="on_save"->act=get(name)<>:
         -> act=show(blob)
      -> item:name="demo" event="on_open"->act=set(model "data.js demo")<>:
         -> act=show(model)
      -> item:name="tail" event="on_load"->act=load("draft")<>:
         -> act=load(live)
         -> act=show(model)
      -> show(io)

part 4: "check"
   -> frm:name="live":
      -> item:name="validate" event="on_edit"->act=select(src "dict protos blueprints syntax")<>:
         -> act=run(validator)
         -> act=show(verdict)
      -> item:name="markers" event="on_run"->act=run(model "lang vibedsl")<>:
         -> act=show(result)
      -> item:name="badge" event="on_run"->act=select(cls "pass or fail")<>:
         -> act=show(verdict + errors + warnings)
      -> item:name="list" event="on_run"->act=show(result)<>:
         -> act=show("line col message")
      -> item:name="jump" event="on_pick"->act=set(position)<>:
         -> act=show(reveal)
      -> exm: frm result="verdict, errors, warnings, rows, none"
      -> show(result)

part 5: "panel"
   -> frm:name="ref":
      -> item:name="cache" event="on_panel"->act=run(validate "per section")<>:
         -> act=show(checkmark)
         -> act=show(fail count)
      -> item:name="view" event="on_pick"->act=open(sec)<>:
         -> act=show(header)
         -> act=show(src)
      -> item:name="toggle" event="on_click"->act=set(aside)<>:
         -> act=show(active)
         -> act=show(layout)
      -> exm: frm src="action, mapping, operators, abstracts, syntax"
      -> show(panel)

part 6: "add"
   -> frm:name="add":
      -> item:name="check" event="on_input"->act=select(value, desc)<>:
         -> act=ret(rsn "value and description are required")
         -> act=ret(rsn "alias already in dictionary")
         -> act=save(key "vibedsl.addref")
         -> out:"error + server message"
         -> out:"server unreachable"
      -> item:name="preview_run" event="on_input"->act=show(preview)<>:
         -> act=show("*-> value - desc, exm indented")
      -> exm: frm entry="section, value, desc, exm, preview, result"
      -> show(entry)

part 7: "core"
   -> frm:name="finder":
      -> item:name="known_run" event="on_run"->act=set(known "dict aliases + syntax aliases + stage scop srch mix")<>:
         -> act=show(known)
      -> item:name="reset" event="on_run"->act=set(typed "clear")<>:
         -> act=set(reach "clear")
      -> item:name="mask" event="on_run"->act=set(scan "custom + comments blanked, strings kept")<>:
         -> act=show(scan)
      -> item:name="tree" event="on_run"->act=set(scan "tabs to spaces, skip blank and hash, indent stack")<>:
         -> act=show(scan)
      -> item:name="decls_run" event="on_run"->act=set(decls "abstract ids, as binds, fun names, entity act pairs")<>:
         -> act=show(decls)
      -> item:name="typed" event="on_run"->act=set(typed "function, prop, item, pin pairs from init")<>:
         -> act=show(typed)
      -> item:name="use_run" event="on_run"->act=set(use_map "agent skip, source skip, proto list, id, bare words")<>:
         -> act=show(use_map)
      -> item:name="reach" event="on_run"->act=run(walk "recursive entry walk, seen guard")<>:
         -> act=show(reach)
      -> item:name="block" event="on_run"->act=run(union "symbols upward")<>:
         -> act=show(block)
      -> item:name="dup_check" event="on_run"->act=run(dup "ids vs reachable base + earlier ids")<>:
         -> out:"duplicate id"
      -> item:name="rules" event="on_run"->act=show(rows "1 2 3 4 5 6")<>:
         -> act=show(r1 "branch needs indented arrow children")
         -> act=show(r2 "change operator needs act inside")
         -> act=show(r3 "scan line start + operators, known and visible pass")
         -> act=show(r4 "object pin must be owned or visible")
         -> act=show(r5 "parens balance with scope")
         -> act=show(r6 "missing use target reported")
      -> item:name="marker" event="on_run"->act=show(locate "message quote in raw line")<>:
         -> act=show(marker)
      -> item:name="out_run" event="on_run"->act=show(out "sorted by line kind message, deduped, verdict")<>:
         -> act=show(shape "out, markers sev 8, nerr, nwarn, verdict")
      -> show(core)

part 8: "parity"
   -> frm:name="parity":
      -> item:name="goal_run" event="on_run"->act=set(goal "js byte identical to python, modulo CRLF")<>:
         -> act=show(goal)
      -> item:name="feed_run" event="on_run"->act=set(feed "same source both sides, normalized")<>:
         -> act=show(feed)
      -> item:name="files_run" event="on_run"->act=set(files "syntax, protos, blueprints, dict, demo")<>:
         -> act=show(files)
      -> item:name="lines" event="on_run"->act=show("undeclared, use missing, evt scopes, load, multivec, pins, inline, custom")<>:
         -> swt:state:
            -> case "diff":
               -> ret(rsn "exit 1")
            -> case "same":
               -> ret(rsn "exit 0")
      -> show(parity)

part 9: "pipe"
   -> frm:name="pipe":
      -> item:name="gen" event="on_pipe"->act=select(src "dict, splits, protos, blueprints, syntax, demo")<>:
         -> act=run(read)
         -> act=show(data)
      -> item:name="write" event="on_pipe"->act=write(data "header + payload, dict, dictName, sections, protos, blueprints, syntax, demo")<>:
         -> act=run(export "module + window")
      -> item:name="sort" event="on_pipe"->act=run(sort "type headers, entries at arrows, primary alias, case insensitive")<>:
         -> act=run(parts "action, mapping, logical operators, abstracts + behavior, 4 files")
      -> item:name="prefix" event="on_pipe"->act=run(count "start language dictionary, count entries")<>:
         -> out:"missing section"
      -> item:name="stage2" event="on_pipe"->act=run(search "4 terms")<>:
         -> act=run(mix)
         -> act=run(rebuild)
      -> item:name="push" event="on_pipe"->act=run(check "section, value, desc, no dash, no dup")<>:
         -> act=run(insert "before next section header")
         -> act=run(rebuild "sort write, parts, gen")
      -> show(data)

part 10: "api"
   -> frm:name="api":
      -> item:name="router" event="http_request"->act=select(path)<>:
         -> root(path)->act=open(page)
         -> act=open(file)
         -> out:"http 404"
      -> item:name="lib" event="on_api"->act=build("page html normalizer")<>:
         -> data=mem:map
      -> item:name="index" event="on_api"->act=open(page)<>:
         -> act=show("logo, syntax, vectors, ui, scope, endpoints")
      -> item:name="get" event="http_request"->act=select(dict)<>:
         -> act=show(dict)
         -> out:"http 404 + valid list"
      -> item:name="search" event="http_request"->act=select(term)<>:
         -> act=split("arrows")
         -> act=show("dict syntax agents only, case sensitive")
      -> item:name="save" event="http_request"->act=set(name)<>:
         -> act=write(".vibe temp store")
         -> out:"http 400"
      -> item:name="add" event="http_request"->act=select(section)<>:
         -> act=write("one line")
         -> out:"length cap"
      -> item:name="add_pipe" event="on_api"->act=run(find "python")<>:
         -> act=run(pipeline)
         -> act=show("echo last json")
      -> item:name="proto" event="http_request"->act=select(id)<>:
         -> act=show("exact id get, substring id desc search")
      -> show(api)

part 11: "gates"
   -> frm:name="gates":
      -> item:name="spec" event="on_gate"->act=run(validate "declared or visible words, scopes balanced")<>:
         -> act=ret("pass")
         -> out:"fail"
      -> item:name="parity_run" event="on_gate"->act=run(test "all cases pass")<>:
         -> act=ret("pass")
         -> out:"fail"
      -> item:name="dict" event="on_gate"->act=run(validate "action, mapping, operators, abstracts, syntax clean")<>:
         -> act=ret("pass")
         -> out:"fail"
      -> show(gates)

part 12: "off"
   -> frm:name="off":
      -> item:name="hand" event="on_off"->act=set(pairs "two working pairs")<>:
         -> act=show("divergence under 5 percent, comments free")
      -> item:name="verify" event="on_off"->act=run(both "run and pass the gates")<>:
         -> act=ret("done")
         -> out:"fail"
      -> show(off)

part 13: "deliver"
   -> frm:name="deliver":
      -> item:name="handoff" event="on_deliver"->act=crt:path"/example/IDE"<>:
         -> act=save("IDE.vibe", "IDE_eng.spec")
         -> act=show("check KV cache size")
         -> act=crt:file("README.md")
         -> act=save()
      -> show(deliver)

use(agent:name="coder")
use(agent:name="dsl-plan")