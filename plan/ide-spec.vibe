fun type="root" name="vibedsl-ide" id="vibedsl-ide" scop="root" -> act == crt [spec] lng="VibeDSL"
   -> show units="frame boot slot io check panel add core parity pipe api gates off"

part 0: "frame"
   module name="page" id="ide_frame" out="html" act=[crt,show]
      -> crt fun name="zone" par="name" out="html"
      -> show name="header" pod="title, status, name, saved, open, save, demo, help, file"
      -> show name="work" pod="editor, panel"
      -> show name="bottom" pod="problems, log"
      -> show name="modal" pod="section, value, desc, exm, preview, result"
      -> crt fun name="theme" par="area" out="code"
      -> show name="base" bg="#1e1e1e" text="#d4d4d4" panel="#252526" border="#3c3c3c"
      -> show name="marks" pass="#6a9955" fail="#f48771" log="#9cdcfe" title="#4ec9b0" focus="#3794ff"
      -> show name="sizes" aside="25 percent" bottom="32 percent" open="150ms"
      -> show name="scripts" load="monaco, data.js, validator.js, main.js"
      -> ret ok

part 1: "boot"
   module name="monaco" id="ide_boot" lng="js" act=[crt,show]
      -> crt fun name="init" par="void" out="void"
      -> run name="guard" act="throw -> badge fail + log stack"
      -> run name="loader" src="temp/package/min/vs" mode="local or host"
      -> run name="register" lang="vibedsl" extn=".vibe", ".txt"
      -> run name="config" act="comment, block, brackets, auto close brackets and quotes"
      -> run name="monarch" postfix=".vibedsl"
      -> run name="classes" act="comment, key, operator, delimiter, string, invalid, number, id"
      -> run name="keys" act="fun func function abstract alias as use type act name par desc id ret halt"
      -> run name="operators" act="multi vector, colon branch, two way link, ampersand arrow, double colon, point colon, arrows, alone branch, comparators, ternary, set"
      -> run name="options" theme="vs-dark" layout="auto" minimap="off" font="14" beyond="no"
      -> run name="model" src="data.js demo" lang="vibedsl"
      -> ret ok

part 2: "slot"
   module name="draft" id="ide_slot" lng="js" act=[save,ret,show]
      -> show name="keys" active="vibedsl.active" text="vibedsl.draft:name"
      -> crt fun name="resolve" par="input" out="name"
      -> run name="empty" act="edit.vibe"
      -> run name="no_dot" act="append .vibe"
      -> crt fun name="store" par="key, value" out="void"
      -> run name="local" act="try set, catch private mode"
      -> crt fun name="restore" par="void" out="void"
      -> run name="boot" act="read active, read text, skip if demo, badge draft restored"
      -> crt fun name="server" par="quiet" out="void"
      -> run name="post" api="API/save" body="json name text" guard="http only"
      -> show name="ok" act="badge saved HH:MM:SS + path"
      -> exam:fail<>:
         -> ret act="badge save error + message"
      -> exam:off<>:
         -> ret act="badge no autosave server router down"
      -> run name="timers" check="250ms" slot="400ms" mark="editing"
      -> run name="auto" period="10s" unload="yes" hidden="yes"
      -> ret ok

part 3: "io"
   module name="io" id="ide_io" lng="js" act=[open,save,show]
      -> show name="open" act="hidden file input, read text, set name, replace model"
      -> show name="after" act="save slot, push server, focus, reset input"
      -> show name="save" act="resolve name, blob download"
      -> show name="demo" act="set model from data.js demo"
      -> show name="tail" act="restore, validate, focus"
      -> ret ok

part 4: "check"
   module name="live" id="ide_check" lng="js" act=[exam,show]
      -> crt fun name="now" par="text" out="result"
      -> run name="call" obj="VibeDSLValidator" fn="validate" src="dict, protos, blueprints, syntax"
      -> run name="markers" apply="model" lang="vibedsl"
      -> run name="badge" show="verdict + errors + warnings" cls="pass or fail"
      -> run name="log" show="result lines"
      -> run name="list" row="line:col message" sev="8"
      -> show name="jump" act="set position, reveal, focus"
      -> show name="empty" act="no errors row"
      -> ret ok

part 5: "panel"
   module name="ref" id="ide_panel" lng="js" act=[show,exam]
      -> show name="refs" sec="action, mapping, operators, abstracts, syntax"
      -> run name="keys" act="exactly those five"
      -> run name="cache" act="one validate per section, src prefix dict:"
      -> show name="badge" act="pass checkmark, fail count"
      -> show name="view" act="check head + section source"
      -> show name="toggle" act="aside open, active class, editor layout"
      -> ret ok

part 6: "add"
   module name="add" id="ide_add" lng="js" act=[crt,chk,exam]
      -> crt fun name="aliases" par="dict" out="set" act="exact + lowercase"
      -> crt fun name="preview" par="value, desc, exm" out="text"
      -> run name="block" act="*-> value - desc, exm indented"
      -> crt fun name="open" par="section" out="void"
      -> run name="clean" section="syntax" stop="action"
      -> crt fun name="submit" par="fields" out="void"
      -> exam:empty<>:
         -> ret act="value and description are required"
      -> exam:dup<>:
         -> ret act="alias already in dictionary + alias"
      -> run name="post" api="API/dict_add" body="json section value desc exm"
      -> exam:ok<>:
         -> save key="vibedsl.addref" val="section"
         -> run name="reload" after="400ms"
      -> exam:err<>:
         -> ret act="error + server message"
      -> exam:down<>:
         -> ret act="server unreachable router down"
      -> run name="hint" act="typing recomposes preview"
      -> ret ok

part 7: "core"
   module name="finder" id="vl_core" lng="py and js" act=[exam,scan,ret]
      -> run name="known" act="dict aliases + syntax aliases + stage scop srch mix"
      -> run name="reset" act="typed + reach cleared per run"
      -> run name="mask" act="custom + comments blanked, strings kept"
      -> run name="tree" act="tabs to spaces, skip blank and hash, indent stack"
      -> run name="decls" act="abstract ids, as binds, fun names, entity act pairs"
      -> run name="typed" act="function prop item, pin pairs from init"
      -> run name="use" act="agent skip, source skip, proto list, id, bare words"
      -> run name="reach" act="recursive entry walk, seen guard"
      -> run name="block" act="symbols union upward"
      -> run name="dup" act="ids vs reachable base + earlier ids"
      -> run name="rule 1" act="branch needs indented arrow children"
      -> run name="rule 2" act="change operator needs act inside"
      -> run name="rule 3" act="scan line start + operators, known and visible pass"
      -> run name="rule 4" act="object pin must be owned or visible"
      -> run name="rule 5" act="parens balance with scope"
      -> run name="rule 6" act="missing use target reported"
      -> run name="scan" act="quotes masked, glued skipped, branch child stripped"
      -> run name="marker" act="message quote located in raw line"
      -> run name="out" act="sorted by line kind message, deduped"
      -> run name="shape" act="out, markers sev 8, nerr, nwarn zero, verdict"
      -> ret ok

part 8: "parity"
   module name="parity" id="test_same" lng="js" act=[run,exam]
      -> show name="goal" act="js byte identical to python, modulo CRLF"
      -> run name="feed" act="same source both sides, normalized"
      -> run name="files" act="syntax, protos, blueprints, dict, demo"
      -> run name="lines" act="undeclared, use missing, evt scopes, load, srch, multivec, pins, inline, custom"
      -> exam:diff<>:
         -> ret exit="1"
      -> ret exit="0"

part 9: "pipe"
   module name="pipe" id="data_pipe" lng="py" act=[crt,sort,save]
      -> crt fun name="gen" par="data" out="data.js"
      -> run name="read" act="dict, splits, protos, blueprints, syntax, demo"
      -> run name="demo" src="temp demo" fallback="inline example"
      -> run name="write" act="header + payload dict dictName sections protos blueprints syntax demo"
      -> run name="export" act="module + window"
      -> crt fun name="sort" par="master" out="master"
      -> run name="split" act="type headers, entries at arrows, primary alias, case insensitive"
      -> crt fun name="parts" par="sections" out="files"
      -> run name="map" act="action, mapping, logical operators, abstracts + behavior -> 4 files"
      -> run name="prefix" act="start language dictionary, count entries"
      -> show name="missing" act="abort + section list"
      -> show name="stage2" act="get whole dict, search 4 terms, mix, rebuild"
      -> crt fun name="push" par="json" out="json"
      -> run name="checks" act="section, value, desc, no dash value, no dup"
      -> run name="insert" act="before next section header"
      -> run name="rebuild" act="sort write, parts, gen"
      -> ret ok

part 10: "api"
   module name="api" id="php_api" lng="php" act=[get,ret,save]
      -> show name="router" act="root index, real path, self 404, prefix, no dot"
      -> show name="lib" act="page wrapper, html normalizer, map 9 names"
      -> show name="index" act="logo, syntax, vectors, ui, scope, endpoints"
      -> run name="get" act="dict param, default dictionary, 404 + valid list"
      -> run name="search" act="dict syntax agents only, split arrows, case sensitive"
      -> run name="save" act="post put json form, sanitize name, .vibe, GLOS/temp"
      -> show name="add" act="json only, cors, allowed section, one line, length caps"
      -> show name="add_pipe" act="temp input, find python, run, echo last json"
      -> show name="proto" act="exact id get, substring id desc search"
      -> ret ok

part 11: "gates"
   -> run name="spec" act="declared or visible words, scopes balanced"
   -> run name="parity" act="all cases pass"
   -> run name="dict" act="action, mapping, operators, abstracts, syntax clean"
   -> ret ok

part 12: "off"
   -> show name="hand" act="two working pairs, divergence under 5 percent, comments free"
   -> show name="check" act="both variants run and pass the gates"
   -> ret ok

use(agent name="coder")
use(agent name="dsl-plan")