stage 2: object spell checker
   abstract function id="object_checker" -> src:scop in memory
      crt mod="scan" as scan all objects
   abstract{abstract full syntax} function{function,prop,item} id="abs" {"type","init"} -> {logic}
   abstract prop id="object" {"name","track"} -> {any syntax allowed}
   object:act="wrap as one":name="wrap"      -> {extension by id: object:wrap becomes a pin}
   abstract item id="line" {"text"} -> {any syntax allowed}
   -> show(object_checker)
   -> show(object:name)
   -> show(object:wrap)
   -> show(line:text)
   use(agent name="dsl-plan")