<?php
declare(strict_types=1);
mb_internal_encoding('UTF-8');

/**
 * VibeDSL API - get
 * GET ?dict=<dictionary|action|mapping|operators|abstracts|syntax|blueprints|protos|agents>
 * par name="dict" as in
 * logc=get -> ret file: sel[...] == in:content
 * ret html: \r\n -> <br>, tab/space indentation -> &nbsp;
 */

$base = dirname(__DIR__);
require $base . '/API/lib';
$map = vibedslSources($base);

$dict = strtolower(trim((string)($_GET['dict'] ?? 'dictionary')));

header('Content-Type: text/html; charset=utf-8');

$file = $map[$dict] ?? null;
if ($file === null || !is_file($file)) {
    http_response_code(404);
    echo vibedslPage(
        sprintf('[404] no source for "%s". valid: %s', $dict, implode(' ', array_keys($map))),
        'VibeDSL get'
    );
    exit;
}

echo vibedslToHtml((string)file_get_contents($file), 'VibeDSL get: ' . $dict);